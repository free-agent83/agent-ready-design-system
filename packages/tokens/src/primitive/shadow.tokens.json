{
  "$type": "shadow",
  "shadow": {
    "primitive": {
      "elevation": {
        "$type": "shadow",
        "sm":      { "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.05)" },
        "md":      { "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.10), 0px 2px 4px -2px hsl(0 0% 0% / 0.10)" },
        "lg":      { "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.10), 0px 4px 6px -2px hsl(0 0% 0% / 0.10)" },
        "sm-dark": { "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.30)" },
        "md-dark": { "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.40), 0px 2px 4px -2px hsl(0 0% 0% / 0.40)" },
        "lg-dark": { "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.45), 0px 4px 6px -2px hsl(0 0% 0% / 0.45)" }
      }
    }
  }
}
