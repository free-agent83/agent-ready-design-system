{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.{ts,tsx,mjs}",
      "!{projectRoot}/**/*.test-d.ts",
      "!{projectRoot}/**/*.stories.tsx",
      "!{projectRoot}/tests/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test:types": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    }
  }
}
